@page "/categories"
@inherits PageBase
@inject ICategoryService CategoryService

<PageTitle>Kategorier</PageTitle>

<h1>Kategorier</h1>

<PageMessages NotImplemented="NotImplemented" Success="@SuccessMessage" Warning="@WarningMessage" Error="@ErrorMessage" />

<table class="table">
    <thead>
        <tr><th>Namn</th><th>Gräns per vecka</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (Category category in categories)
        {
            <tr>
                <td>@category.Name</td>
                <td>
                    @* Du behöver bygga ut detta mer: visa nuvarande gräns när Category har det fältet. *@
                    <div class="d-flex gap-2">
                        <input class="form-control form-control-sm" style="width:6rem" @bind="limitTexts[category.Id]" />
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => SetLimit(category)">Spara</button>
                    </div>
                </td>
                <td class="text-end">
                    @if (pendingDelete?.Id == category.Id)
                    {
                        <span class="me-2">Recepten flyttas till "Övrigt". Fortsätta?</span>
                        <button class="btn btn-sm btn-danger" @onclick="ConfirmDelete">Ja, ta bort</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => pendingDelete = null">Nej</button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => pendingDelete = category">Ta bort</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<h2 class="h5 mt-4">Lägg till kategori</h2>
<form class="row g-2" @onsubmit="AddCategory">
    <div class="col-auto">
        <input class="form-control" @bind="newName" placeholder="Till exempel Grill" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Lägg till</button>
    </div>
</form>

@code {
    private List<Category> categories = new();
    private Dictionary<int, string> limitTexts = new();
    private string newName = "";
    private Category? pendingDelete;

    protected override void OnInitialized() => LoadCategories();

    private void LoadCategories()
    {
        categories = TryGet(CategoryService.GetAll, new List<Category>());
        limitTexts = categories.ToDictionary(c => c.Id, _ => "");
    }

    private void AddCategory()
    {
        // Ingen kontroll av tom text här: den regeln hör hemma i CategoryService.
        string name = newName;
        if (TryRun(() => CategoryService.Add(name)))
        {
            LoadCategories();
            SuccessMessage = $"Kategorin \"{name}\" är tillagd.";
            newName = "";
        }
    }

    private void SetLimit(Category category)
    {
        if (!InputParser.TryParseInt(limitTexts[category.Id], 1, 21, out int max))
        {
            ClearMessages();
            ErrorMessage = "Gränsen måste vara ett heltal mellan 1 och 21.";
            return;
        }

        if (TryRun(() => CategoryService.SetWeeklyLimit(category.Id, max)))
        {
            SuccessMessage = $"Gränsen för {category.Name} är sparad.";
        }
    }

    private void ConfirmDelete()
    {
        Category category = pendingDelete!;
        pendingDelete = null;

        if (TryRun(() => CategoryService.Delete(category.Id)))
        {
            LoadCategories();
            SuccessMessage = $"Kategorin \"{category.Name}\" är borttagen.";
        }
    }
}
