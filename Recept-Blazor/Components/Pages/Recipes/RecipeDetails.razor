@page "/recipes/{Id:int}"
@inherits PageBase
@inject IRecipeRepository Repository
@inject IRecipeCalculator Calculator

<PageTitle>@(recipe?.Name ?? "Recept")</PageTitle>

@if (recipe is null)
{
    <h1>Receptet finns inte</h1>
    <p>Det finns inget recept med nummer @Id. <a href="recipes">Tillbaka till recepten</a></p>
    return;
}

<h1>@recipe.Name</h1>
<p class="text-muted">
    @shownServings portioner
    @if (shownServings != recipe.Servings)
    {
        <span>(receptet är skrivet för @recipe.Servings)</span>
    }
</p>

<PageMessages NotImplemented="NotImplemented" Success="@SuccessMessage" Warning="@WarningMessage" Error="@ErrorMessage" />

<ul>
    @foreach (Ingredient ingredient in ingredients)
    {
        <li>@Calculator.FormatAmount(ingredient.Amount, ingredient.Unit) @ingredient.Name</li>
    }
</ul>

@* Du behöver bygga ut detta mer: visa kategori, kock och anteckning. *@

<form class="row g-2 align-items-end mb-3" @onsubmit="Rescale">
    <div class="col-auto">
        <label for="servings" class="form-label">Visa för antal portioner</label>
        <input id="servings" class="form-control" @bind="servingsText" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Räkna om</button>
    </div>
</form>

<a class="btn btn-link" href="recipes">Tillbaka till recepten</a>

@code {
    [Parameter] public int Id { get; set; }

    private Recipe? recipe;
    private List<Ingredient> ingredients = new();
    private int shownServings;
    private string servingsText = "";

    protected override void OnParametersSet()
    {
        recipe = TryGet(() => Repository.GetRecipe(Id), null);
        if (recipe is null)
        {
            return;
        }

        ingredients = recipe.Ingredients;
        shownServings = recipe.Servings;
        servingsText = recipe.Servings.ToString();
    }

    private void Rescale()
    {
        if (!InputParser.TryParseInt(servingsText, 1, 100, out int servings))
        {
            ClearMessages();
            ErrorMessage = "Antal portioner måste vara ett heltal mellan 1 och 100.";
            return;
        }

        List<Ingredient>? scaled = TryGet<List<Ingredient>?>(() => Calculator.ScaleIngredients(recipe!, servings), null);
        if (scaled is not null)
        {
            ingredients = scaled;
            shownServings = servings;
        }
    }
}
