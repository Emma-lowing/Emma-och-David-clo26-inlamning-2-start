@page "/recipes"
@inherits PageBase
@inject IRecipeRepository Repository

<PageTitle>Recept</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Recept</h1>
    <a class="btn btn-primary" href="recipes/create">Lägg till recept</a>
</div>

<PageMessages NotImplemented="NotImplemented" Success="@SuccessMessage" Warning="@WarningMessage" Error="@ErrorMessage" />

<form class="row g-2 mb-3" @onsubmit="Search">
    <div class="col-auto">
        <input class="form-control" @bind="searchText" placeholder="Sök på ingrediens" />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-primary" type="submit">Sök</button>
        @if (isSearching)
        {
            <button class="btn btn-link" type="button" @onclick="ShowAll">Visa alla</button>
        }
    </div>
</form>

@if (recipes.Count == 0)
{
    <p>@(isSearching ? "Inga recept hittades." : "Det finns inga recept än.")</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Namn</th><th>Portioner</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (Recipe recipe in recipes)
            {
                <tr>
                    <td>@recipe.Name</td>
                    <td>@recipe.Servings</td>
                    @* Du behöver bygga ut detta mer: visa kategori och kock när modellen har dem. *@
                    <td class="text-end">
                        @if (pendingDelete?.Id == recipe.Id)
                        {
                            @* Önskemål 5: bekräfta innan något tas bort. *@
                            <span class="me-2">Är du säker?</span>
                            <button class="btn btn-sm btn-danger" @onclick="ConfirmDelete">Ja, ta bort</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelDelete">Nej</button>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-primary" href="recipes/@recipe.Id">Visa</a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => pendingDelete = recipe">Ta bort</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Recipe> recipes = new();
    private string searchText = "";
    private bool isSearching;
    private Recipe? pendingDelete;

    protected override void OnInitialized() => ShowAll();

    private void ShowAll()
    {
        searchText = "";
        isSearching = false;
        recipes = TryGet(Repository.GetAllRecipes, new List<Recipe>());
    }

    private void Search()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            ShowAll();
            return;
        }

        isSearching = true;
        recipes = TryGet(() => Repository.SearchByIngredient(searchText.Trim()), new List<Recipe>());
    }

    private void ConfirmDelete()
    {
        Recipe recipe = pendingDelete!;
        pendingDelete = null;

        if (TryRun(() => Repository.DeleteRecipe(recipe.Id)))
        {
            ShowAll();
            SuccessMessage = $"\"{recipe.Name}\" är borttaget.";
        }
    }

    private void CancelDelete() => pendingDelete = null;
}
