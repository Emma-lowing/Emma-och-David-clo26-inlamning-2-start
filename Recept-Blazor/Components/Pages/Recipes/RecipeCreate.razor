@page "/recipes/create"
@inherits PageBase
@inject IRecipeRepository Repository
@inject NavigationManager Navigation

<PageTitle>Lägg till recept</PageTitle>

<h1>Lägg till recept</h1>

<PageMessages NotImplemented="NotImplemented" Success="@SuccessMessage" Warning="@WarningMessage" Error="@ErrorMessage" />

@if (validationErrors.Count > 0)
{
    <ul class="text-danger">
        @foreach (string error in validationErrors)
        {
            <li>@error</li>
        }
    </ul>
}

<form @onsubmit="Save">
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="form-label" for="name">Namn</label>
            <input id="name" class="form-control" @bind="name" />
        </div>
        <div class="col-md-2">
            <label class="form-label" for="servings">Antal portioner</label>
            <input id="servings" class="form-control" @bind="servingsText" />
        </div>
    </div>

    @* Du behöver bygga ut detta mer: fält för kategori, kock och anteckning när modellen Recipe har dem. *@

    <h2 class="h5">Ingredienser</h2>
    <table class="table table-sm">
        <thead>
            <tr><th>Ingrediens</th><th style="width:10rem">Mängd</th><th style="width:10rem">Enhet</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (IngredientRow row in rows)
            {
                <tr>
                    <td><input class="form-control" @bind="row.Name" placeholder="vetemjöl" /></td>
                    <td><input class="form-control" @bind="row.Amount" placeholder="2,5" /></td>
                    <td><input class="form-control" @bind="row.Unit" placeholder="dl" /></td>
                    <td><button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => rows.Remove(row)">Ta bort</button></td>
                </tr>
            }
        </tbody>
    </table>
    <button type="button" class="btn btn-sm btn-outline-primary mb-3" @onclick="() => rows.Add(new IngredientRow())">Lägg till rad</button>

    <div>
        <button type="submit" class="btn btn-primary">Spara</button>
        <a class="btn btn-link" href="recipes">Avbryt</a>
    </div>
</form>

@code {
    private string name = "";
    private string servingsText = "4";
    private List<IngredientRow> rows = new() { new(), new(), new() };
    private List<string> validationErrors = new();

    private void Save()
    {
        validationErrors.Clear();
        var recipe = new Recipe { Name = name.Trim() };

        if (recipe.Name.Length == 0)
        {
            validationErrors.Add("Receptet måste ha ett namn.");
        }
        if (InputParser.TryParseInt(servingsText, 1, 100, out int servings))
        {
            recipe.Servings = servings;
        }
        else
        {
            validationErrors.Add("Antal portioner måste vara ett heltal mellan 1 och 100.");
        }

        for (int i = 0; i < rows.Count; i++)
        {
            IngredientRow row = rows[i];
            if (row.IsEmpty)
            {
                continue;
            }

            if (string.IsNullOrWhiteSpace(row.Name))
            {
                validationErrors.Add($"Rad {i + 1}: ingrediensen saknar namn.");
            }
            if (!InputParser.TryParseDecimal(row.Amount, out decimal amount) || amount < 0)
            {
                validationErrors.Add($"Rad {i + 1}: \"{row.Amount}\" är ingen giltig mängd. Skriv till exempel 2,5.");
            }
            if (string.IsNullOrWhiteSpace(row.Unit))
            {
                validationErrors.Add($"Rad {i + 1}: skriv en enhet, till exempel dl.");
            }

            recipe.Ingredients.Add(new Ingredient { Name = row.Name.Trim(), Amount = amount, Unit = row.Unit.Trim() });
        }

        if (validationErrors.Count > 0)
        {
            return;
        }

        if (TryRun(() => Repository.AddRecipe(recipe)))
        {
            Navigation.NavigateTo("recipes");
        }
    }

    // En rad i formuläret. Allt är text, så att felaktig inmatning kan visas som ett meddelande.
    private class IngredientRow
    {
        public string Name { get; set; } = "";
        public string Amount { get; set; } = "";
        public string Unit { get; set; } = "";

        public bool IsEmpty => string.IsNullOrWhiteSpace(Name) && string.IsNullOrWhiteSpace(Amount) && string.IsNullOrWhiteSpace(Unit);
    }
}
