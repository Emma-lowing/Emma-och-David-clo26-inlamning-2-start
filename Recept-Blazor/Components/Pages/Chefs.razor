@page "/chefs"
@inherits PageBase
@inject IRecipeRepository Repository

<PageTitle>Kockar</PageTitle>

<h1>Kockar</h1>

<PageMessages NotImplemented="NotImplemented" Success="@SuccessMessage" Warning="@WarningMessage" Error="@ErrorMessage" />

@if (chefs.Count == 0)
{
    <p>Det finns inga kockar än.</p>
}
else
{
    <ul class="list-group mb-4">
        @foreach (Chef chef in chefs)
        {
            <li class="list-group-item">@chef.FirstName @chef.LastName</li>
        }
    </ul>
}

<h2 class="h5">Lägg till kock</h2>

@* Fälten följer modellen Chef. Tar ni bort ett fält ur modellen, ta bort raden här också. *@
<form class="col-md-6" @onsubmit="AddChef">
    <div class="mb-3">
        <label class="form-label" for="firstName">Förnamn</label>
        <input id="firstName" class="form-control" @bind="newChef.FirstName" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="lastName">Efternamn</label>
        <input id="lastName" class="form-control" @bind="newChef.LastName" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="birthDate">Födelsedatum</label>
        <input id="birthDate" type="date" class="form-control" @bind="newChef.BirthDate" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="hairColor">Hårfärg</label>
        <input id="hairColor" class="form-control" @bind="newChef.HairColor" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="height">Längd i cm</label>
        <input id="height" class="form-control" @bind="heightText" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="religion">Religion</label>
        <input id="religion" class="form-control" @bind="newChef.Religion" />
    </div>

    <button type="submit" class="btn btn-primary">Spara</button>
</form>

@code {
    private List<Chef> chefs = new();
    private Chef newChef = new();
    private string heightText = "";

    protected override void OnInitialized() => LoadChefs();

    private void LoadChefs() => chefs = TryGet(Repository.GetAllChefs, new List<Chef>());

    private void AddChef()
    {
        ClearMessages();
        if (string.IsNullOrWhiteSpace(newChef.FirstName))
        {
            ErrorMessage = "Kocken måste ha ett förnamn.";
            return;
        }
        if (heightText.Length > 0)
        {
            if (!InputParser.TryParseInt(heightText, 0, 300, out int height))
            {
                ErrorMessage = "Längden måste vara ett heltal mellan 0 och 300.";
                return;
            }
            newChef.HeightCm = height;
        }

        Chef added = newChef;
        if (TryRun(() => Repository.AddChef(added)))
        {
            LoadChefs();
            SuccessMessage = $"Kocken {added.FirstName} är tillagd.";
            newChef = new Chef();
            heightText = "";
        }
    }
}
