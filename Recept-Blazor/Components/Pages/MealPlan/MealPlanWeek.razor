@page "/mealplan"
@inherits PageBase
@inject IMealPlanService MealPlan
@inject IRecipeRepository Repository

<PageTitle>Veckoplan</PageTitle>

<h1>Veckoplan@(week > 0 ? $", vecka {week}" : "")</h1>

<PageMessages NotImplemented="NotImplemented" Success="@SuccessMessage" Warning="@WarningMessage" Error="@ErrorMessage" />

<WeekPicker OnWeekSelected="LoadWeek" />

@if (meals.Count == 0)
{
    <p>Inga måltider är planerade den här veckan.</p>
}
else
{
    <table class="table">
        <tbody>
            @foreach (PlannedMeal meal in meals)
            {
                <tr>
                    <td style="width:14rem">@meal.Date.ToString("dddd d MMMM")</td>
                    <td>@(Repository.GetRecipe(meal.RecipeId)?.Name ?? "(okänt recept)")</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2 class="h5 mt-4">Planera en måltid</h2>
<form class="row g-2 align-items-end" @onsubmit="PlanMeal">
    <div class="col-auto">
        <label class="form-label" for="recipe">Recept</label>
        <select id="recipe" class="form-select" @bind="selectedRecipeId">
            @foreach (Recipe recipe in recipes)
            {
                <option value="@recipe.Id">@recipe.Name</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label" for="date">Datum</label>
        <input id="date" type="date" class="form-control" @bind="selectedDate" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Planera</button>
    </div>
</form>

@code {
    private int year;
    private int week;
    private List<PlannedMeal> meals = new();
    private List<Recipe> recipes = new();
    private int selectedRecipeId;
    private DateOnly? selectedDate;

    protected override void OnInitialized()
    {
        recipes = TryGet(Repository.GetAllRecipes, new List<Recipe>());
        selectedRecipeId = recipes.FirstOrDefault()?.Id ?? 0;
    }

    private void LoadWeek((int Year, int Week) selected)
    {
        (year, week) = selected;
        meals = TryGet(() => MealPlan.GetWeekPlan(year, week), new List<PlannedMeal>())
            .OrderBy(m => m.Date)
            .ToList();
    }

    private void PlanMeal()
    {
        if (selectedDate is null)
        {
            ClearMessages();
            ErrorMessage = "Välj ett datum.";
            return;
        }

        List<string> warnings = new();
        if (TryRun(() => warnings = MealPlan.PlanMeal(selectedRecipeId, selectedDate.Value)))
        {
            LoadWeek((year, week));
            SuccessMessage = "Måltiden är inplanerad.";
            WarningMessage = warnings.Count > 0 ? string.Join(" ", warnings) : null;
        }
    }
}
