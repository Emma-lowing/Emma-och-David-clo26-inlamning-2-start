@page "/shoppinglist"
@inherits PageBase
@inject IMealPlanService MealPlan
@inject IRecipeCalculator Calculator

<PageTitle>Inköpslista</PageTitle>

<h1>Inköpslista@(week > 0 ? $", vecka {week}" : "")</h1>

<PageMessages NotImplemented="NotImplemented" Success="@SuccessMessage" Warning="@WarningMessage" Error="@ErrorMessage" />

<WeekPicker OnWeekSelected="LoadWeek" />

@if (items.Count == 0)
{
    <p>Inköpslistan är tom.</p>
}
else
{
    <ul>
        @foreach (ShoppingListItem item in items)
        {
            <li>@Calculator.FormatAmount(item.Amount, item.Unit) @item.Name</li>
        }
    </ul>
}

@code {
    private int week;
    private List<ShoppingListItem> items = new();

    private void LoadWeek((int Year, int Week) selected)
    {
        week = selected.Week;
        items = TryGet(() => MealPlan.GetShoppingList(selected.Year, selected.Week), new List<ShoppingListItem>());
    }
}
