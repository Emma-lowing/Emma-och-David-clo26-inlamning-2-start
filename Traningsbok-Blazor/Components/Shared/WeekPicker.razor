@using System.Globalization
@* Val av år och vecka. Används av veckoöversikten. *@

<form class="row g-2 align-items-end mb-3" @onsubmit="Submit">
    <div class="col-auto">
        <label class="form-label" for="year">År</label>
        <input id="year" class="form-control" style="width:7rem" @bind="yearText" />
    </div>
    <div class="col-auto">
        <label class="form-label" for="week">Vecka</label>
        <input id="week" class="form-control" style="width:6rem" @bind="weekText" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Visa</button>
    </div>
    @if (error is not null)
    {
        <div class="col-12 text-danger">@error</div>
    }
</form>

@code {
    /// <summary>Anropas med (år, vecka) när användaren valt en giltig vecka.</summary>
    [Parameter] public EventCallback<(int Year, int Week)> OnWeekSelected { get; set; }

    private string yearText = "";
    private string weekText = "";
    private string? error;

    // Utan val visas innevarande vecka. Veckan börjar på måndag (ISO 8601).
    protected override async Task OnInitializedAsync()
    {
        yearText = ISOWeek.GetYear(DateTime.Today).ToString();
        weekText = ISOWeek.GetWeekOfYear(DateTime.Today).ToString();
        await Submit();
    }

    private async Task Submit()
    {
        error = null;
        if (!InputParser.TryParseInt(yearText, 2000, 2100, out int year) ||
            !InputParser.TryParseInt(weekText, 1, 53, out int week))
        {
            error = "Skriv ett år mellan 2000 och 2100 och en vecka mellan 1 och 53.";
            return;
        }
        await OnWeekSelected.InvokeAsync((year, week));
    }
}
