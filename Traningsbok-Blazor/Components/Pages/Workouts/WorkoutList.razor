@page "/workouts"
@inherits PageBase
@inject IWorkoutRepository Repository

<PageTitle>Pass</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Pass</h1>
    <a class="btn btn-primary" href="workouts/create">Lägg till pass</a>
</div>

<PageMessages NotImplemented="NotImplemented" Success="@SuccessMessage" Warning="@WarningMessage" Error="@ErrorMessage" />

@if (workouts.Count == 0)
{
    <p>Det finns inga pass än.</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Datum</th><th>Träningstyp</th><th>Övningar</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (Workout workout in workouts)
            {
                <tr>
                    <td>@workout.Date.ToString("ddd d MMM yyyy")</td>
                    <td>@workout.Type</td>
                    <td>@workout.Exercises.Count</td>
                    @* Du behöver bygga ut detta mer: visa längd och utövare när modellen Workout har dem. *@
                    <td class="text-end">
                        @if (pendingDelete?.Id == workout.Id)
                        {
                            @* Önskemål 5: bekräfta innan något tas bort. *@
                            <span class="me-2">Är du säker?</span>
                            <button class="btn btn-sm btn-danger" @onclick="ConfirmDelete">Ja, ta bort</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelDelete">Nej</button>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-primary" href="workouts/@workout.Id">Visa</a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => pendingDelete = workout">Ta bort</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Workout> workouts = new();
    private Workout? pendingDelete;

    protected override void OnInitialized() => LoadWorkouts();

    private void LoadWorkouts() => workouts = TryGet(Repository.GetAllWorkouts, new List<Workout>());

    private void ConfirmDelete()
    {
        Workout workout = pendingDelete!;
        pendingDelete = null;

        if (TryRun(() => Repository.DeleteWorkout(workout.Id)))
        {
            LoadWorkouts();
            SuccessMessage = $"Passet den {workout.Date:yyyy-MM-dd} är borttaget.";
        }
    }

    private void CancelDelete() => pendingDelete = null;
}
