@page "/workouts/{Id:int}"
@inherits PageBase
@inject IWorkoutRepository Repository
@inject IWorkoutFormatter Formatter

<PageTitle>@(workout?.Type ?? "Pass")</PageTitle>

@if (workout is null)
{
    <h1>Passet finns inte</h1>
    <p>Det finns inget pass med nummer @Id. <a href="workouts">Tillbaka till passen</a></p>
    return;
}

<h1>@workout.Type</h1>
<p class="text-muted">@workout.Date.ToString("dddd d MMMM yyyy")</p>

@* Du behöver bygga ut detta mer: visa längd, anteckning och utövare. *@

<PageMessages NotImplemented="NotImplemented" Success="@SuccessMessage" Warning="@WarningMessage" Error="@ErrorMessage" />

<h2 class="h5">Övningar</h2>
@if (workout.Exercises.Count == 0)
{
    <p>Passet har inga övningar än.</p>
}
else
{
    <ul>
        @foreach (Exercise exercise in workout.Exercises)
        {
            <li>@exercise.Name: @exercise.Sets set × @exercise.Reps reps, @Formatter.FormatWeight(exercise.Weight)</li>
        }
    </ul>
}

<h2 class="h5 mt-4">Lägg till övning</h2>

@if (validationErrors.Count > 0)
{
    <ul class="text-danger">
        @foreach (string error in validationErrors)
        {
            <li>@error</li>
        }
    </ul>
}

<form class="row g-2 align-items-end mb-4" @onsubmit="AddExercise">
    <div class="col-md-4">
        <label class="form-label" for="name">Övning</label>
        <input id="name" class="form-control" @bind="name" placeholder="Knäböj" />
    </div>
    <div class="col-auto">
        <label class="form-label" for="sets">Set</label>
        <input id="sets" class="form-control" style="width:6rem" @bind="setsText" placeholder="3" />
    </div>
    <div class="col-auto">
        <label class="form-label" for="reps">Reps</label>
        <input id="reps" class="form-control" style="width:6rem" @bind="repsText" placeholder="8" />
    </div>
    <div class="col-auto">
        <label class="form-label" for="weight">Vikt i kg</label>
        <input id="weight" class="form-control" style="width:8rem" @bind="weightText" placeholder="62,5" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Lägg till</button>
    </div>
</form>

<a class="btn btn-link" href="workouts">Tillbaka till passen</a>

@code {
    [Parameter] public int Id { get; set; }

    private Workout? workout;
    private string name = "";
    private string setsText = "";
    private string repsText = "";
    private string weightText = "";
    private List<string> validationErrors = new();

    protected override void OnParametersSet() =>
        workout = TryGet(() => Repository.GetWorkout(Id), null);

    private void AddExercise()
    {
        validationErrors.Clear();
        ClearMessages();
        var exercise = new Exercise { Name = name.Trim() };

        if (exercise.Name.Length == 0)
        {
            validationErrors.Add("Övningen måste ha ett namn.");
        }
        if (InputParser.TryParseInt(setsText, 1, 100, out int sets))
        {
            exercise.Sets = sets;
        }
        else
        {
            validationErrors.Add("Antal set måste vara ett heltal mellan 1 och 100.");
        }
        if (InputParser.TryParseInt(repsText, 1, 1000, out int reps))
        {
            exercise.Reps = reps;
        }
        else
        {
            validationErrors.Add("Antal reps måste vara ett heltal mellan 1 och 1000.");
        }

        // Story 6: ogiltig vikt, till exempel "abc", ger ett felmeddelande och ingen övning sparas.
        if (InputParser.TryParseDecimal(weightText, out decimal weight) && weight >= 0 && weight <= 1000)
        {
            exercise.Weight = weight;
        }
        else
        {
            validationErrors.Add($"\"{weightText}\" är ingen giltig vikt. Skriv till exempel 62,5.");
        }

        if (validationErrors.Count > 0)
        {
            return;
        }

        // Passet hämtas igen efter sparandet, så att listan visar det som finns i databasen.
        if (TryRun(() =>
            {
                Repository.AddExercise(workout!.Id, exercise);
                workout = Repository.GetWorkout(workout.Id) ?? workout;
            }))
        {
            SuccessMessage = $"Övningen \"{exercise.Name}\" är tillagd.";
            name = setsText = repsText = weightText = "";
        }
    }
}
