@page "/workouts/create"
@inherits PageBase
@inject IWorkoutRepository Repository
@inject ITrainingTypeService TrainingTypes
@inject IGoalNotifier Goals

<PageTitle>Lägg till pass</PageTitle>

<h1>Lägg till pass</h1>

<PageMessages NotImplemented="NotImplemented" Success="@SuccessMessage" Warning="@WarningMessage" Error="@ErrorMessage" />

@if (validationErrors.Count > 0)
{
    <ul class="text-danger">
        @foreach (string error in validationErrors)
        {
            <li>@error</li>
        }
    </ul>
}

@if (savedWorkout is not null)
{
    <p>
        <a class="btn btn-primary" href="workouts/@savedWorkout.Id">Lägg till övningar i passet</a>
        <a class="btn btn-link" href="workouts">Till passen</a>
    </p>
}

<form class="col-md-6" @onsubmit="Save">
    <div class="mb-3">
        <label class="form-label" for="date">Datum</label>
        <input id="date" type="date" class="form-control" @bind="date" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="type">Träningstyp</label>
        <select id="type" class="form-select" @bind="type">
            <option value="">Välj träningstyp</option>
            @foreach (TrainingType trainingType in trainingTypes)
            {
                <option value="@trainingType.Name">@trainingType.Name</option>
            }
        </select>
    </div>

    @* Du behöver bygga ut detta mer: fält för längd i minuter, anteckning och utövare när modellen Workout har dem. *@

    <button type="submit" class="btn btn-primary">Spara</button>
    <a class="btn btn-link" href="workouts">Avbryt</a>
</form>

@code {
    private List<TrainingType> trainingTypes = new();
    private DateOnly? date = DateOnly.FromDateTime(DateTime.Today);
    private string type = "";
    private List<string> validationErrors = new();
    private Workout? savedWorkout;

    protected override void OnInitialized() =>
        trainingTypes = TryGet(TrainingTypes.GetAll, new List<TrainingType>());

    private void Save()
    {
        validationErrors.Clear();
        savedWorkout = null;

        if (date is null)
        {
            validationErrors.Add("Välj ett datum.");
        }
        if (string.IsNullOrWhiteSpace(type))
        {
            validationErrors.Add("Välj en träningstyp.");
        }
        if (validationErrors.Count > 0)
        {
            ClearMessages();
            return;
        }

        var workout = new Workout { Date = date!.Value, Type = type.Trim() };
        if (!TryRun(() => Repository.AddWorkout(workout)))
        {
            return;
        }
        savedWorkout = workout;

        SuccessMessage = $"Passet den {workout.Date:yyyy-MM-dd} är sparat.";
        ShowGoalMessages(workout);
    }

    // Funktion 6: meddelande när träningstypen når 80 % eller 100 % av veckomålet.
    // Passet är redan sparat, så "Inte implementerat ännu" visas här som en varning
    // under meddelandet om att passet är sparat.
    private void ShowGoalMessages(Workout workout)
    {
        try
        {
            List<string> messages = Goals.CheckGoals(workout);
            WarningMessage = messages.Count > 0 ? string.Join(" ", messages) : null;
        }
        catch (NotImplementedException)
        {
            WarningMessage = "Meddelanden vid veckomålet är inte implementerade ännu: GoalNotifier kastar NotImplementedException.";
        }
    }
}
