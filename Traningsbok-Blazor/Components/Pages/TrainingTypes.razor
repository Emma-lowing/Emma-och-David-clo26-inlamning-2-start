@page "/trainingtypes"
@inherits PageBase
@inject ITrainingTypeService TrainingTypeService

<PageTitle>Träningstyper</PageTitle>

<h1>Träningstyper</h1>

<PageMessages NotImplemented="NotImplemented" Success="@SuccessMessage" Warning="@WarningMessage" Error="@ErrorMessage" />

<table class="table">
    <thead>
        <tr><th>Namn</th><th>Veckomål i minuter</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (TrainingType trainingType in trainingTypes)
        {
            <tr>
                <td>@trainingType.Name</td>
                <td>
                    @* Du behöver bygga ut detta mer: visa nuvarande veckomål när TrainingType har det fältet. *@
                    <div class="d-flex gap-2">
                        <input class="form-control form-control-sm" style="width:7rem" @bind="goalTexts[trainingType.Id]" />
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => SetGoal(trainingType)">Spara</button>
                    </div>
                </td>
                <td class="text-end">
                    @if (pendingDelete?.Id == trainingType.Id)
                    {
                        <span class="me-2">Passen flyttas till "Övrigt". Fortsätta?</span>
                        <button class="btn btn-sm btn-danger" @onclick="ConfirmDelete">Ja, ta bort</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => pendingDelete = null">Nej</button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => pendingDelete = trainingType">Ta bort</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<h2 class="h5 mt-4">Lägg till träningstyp</h2>
<form class="row g-2" @onsubmit="AddTrainingType">
    <div class="col-auto">
        <input class="form-control" @bind="newName" placeholder="Till exempel Klättring" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Lägg till</button>
    </div>
</form>

@code {
    private List<TrainingType> trainingTypes = new();
    private Dictionary<int, string> goalTexts = new();
    private string newName = "";
    private TrainingType? pendingDelete;

    protected override void OnInitialized() => LoadTrainingTypes();

    private void LoadTrainingTypes()
    {
        trainingTypes = TryGet(TrainingTypeService.GetAll, new List<TrainingType>());
        goalTexts = trainingTypes.ToDictionary(t => t.Id, _ => "");
    }

    private void AddTrainingType()
    {
        // Ingen kontroll av tom text här: den regeln hör hemma i TrainingTypeService.
        string name = newName;
        if (TryRun(() => TrainingTypeService.Add(name)))
        {
            LoadTrainingTypes();
            SuccessMessage = $"Träningstypen \"{name}\" är tillagd.";
            newName = "";
        }
    }

    private void SetGoal(TrainingType trainingType)
    {
        // En vecka har 10 080 minuter.
        if (!InputParser.TryParseInt(goalTexts[trainingType.Id], 1, 10080, out int minutes))
        {
            ClearMessages();
            ErrorMessage = "Veckomålet måste vara ett heltal mellan 1 och 10080 minuter.";
            return;
        }

        if (TryRun(() => TrainingTypeService.SetWeeklyGoal(trainingType.Id, minutes)))
        {
            SuccessMessage = $"Veckomålet för {trainingType.Name} är sparat.";
        }
    }

    private void ConfirmDelete()
    {
        TrainingType trainingType = pendingDelete!;
        pendingDelete = null;

        if (TryRun(() => TrainingTypeService.Delete(trainingType.Id)))
        {
            LoadTrainingTypes();
            SuccessMessage = $"Träningstypen \"{trainingType.Name}\" är borttagen.";
        }
    }
}
