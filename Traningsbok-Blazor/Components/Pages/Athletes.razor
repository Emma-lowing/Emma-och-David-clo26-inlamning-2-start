@page "/athletes"
@inherits PageBase
@inject IWorkoutRepository Repository

<PageTitle>Utövare</PageTitle>

<h1>Utövare</h1>

<PageMessages NotImplemented="NotImplemented" Success="@SuccessMessage" Warning="@WarningMessage" Error="@ErrorMessage" />

@if (athletes.Count == 0)
{
    <p>Det finns inga utövare än.</p>
}
else
{
    <ul class="list-group mb-4">
        @foreach (Athlete athlete in athletes)
        {
            <li class="list-group-item">@athlete.FirstName @athlete.LastName</li>
        }
    </ul>
}

<h2 class="h5">Lägg till utövare</h2>

@* Fälten följer modellen Athlete. Tar ni bort ett fält ur modellen, ta bort raden här också. *@
<form class="col-md-6" @onsubmit="AddAthlete">
    <div class="mb-3">
        <label class="form-label" for="firstName">Förnamn</label>
        <input id="firstName" class="form-control" @bind="newAthlete.FirstName" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="lastName">Efternamn</label>
        <input id="lastName" class="form-control" @bind="newAthlete.LastName" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="birthDate">Födelsedatum</label>
        <input id="birthDate" type="date" class="form-control" @bind="newAthlete.BirthDate" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="hairColor">Hårfärg</label>
        <input id="hairColor" class="form-control" @bind="newAthlete.HairColor" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="height">Längd i cm</label>
        <input id="height" class="form-control" @bind="heightText" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="religion">Religion</label>
        <input id="religion" class="form-control" @bind="newAthlete.Religion" />
    </div>

    <button type="submit" class="btn btn-primary">Spara</button>
</form>

@code {
    private List<Athlete> athletes = new();
    private Athlete newAthlete = new();
    private string heightText = "";

    protected override void OnInitialized() => LoadAthletes();

    private void LoadAthletes() => athletes = TryGet(Repository.GetAllAthletes, new List<Athlete>());

    private void AddAthlete()
    {
        ClearMessages();
        if (string.IsNullOrWhiteSpace(newAthlete.FirstName))
        {
            ErrorMessage = "Utövaren måste ha ett förnamn.";
            return;
        }
        if (heightText.Length > 0)
        {
            if (!InputParser.TryParseInt(heightText, 0, 300, out int height))
            {
                ErrorMessage = "Längden måste vara ett heltal mellan 0 och 300.";
                return;
            }
            newAthlete.HeightCm = height;
        }

        Athlete added = newAthlete;
        if (TryRun(() => Repository.AddAthlete(added)))
        {
            LoadAthletes();
            SuccessMessage = $"Utövaren {added.FirstName} är tillagd.";
            newAthlete = new Athlete();
            heightText = "";
        }
    }
}
