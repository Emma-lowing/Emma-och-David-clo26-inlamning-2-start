@page "/exercisestats"
@inherits PageBase
@inject IStatisticsService Statistics
@inject IWorkoutRepository Repository
@inject IWorkoutFormatter Formatter

<PageTitle>Övningsstatistik</PageTitle>

<h1>Statistik för en övning</h1>
<p class="text-muted">Högsta vikt och totalt antal set, i alla pass.</p>

<PageMessages NotImplemented="NotImplemented" Success="@SuccessMessage" Warning="@WarningMessage" Error="@ErrorMessage" />

<form class="row g-2 mb-3" @onsubmit="ShowStats">
    <div class="col-auto">
        <input class="form-control" @bind="name" list="exercise-names" placeholder="Till exempel Knäböj" />
        <datalist id="exercise-names">
            @foreach (string exerciseName in exerciseNames)
            {
                <option value="@exerciseName"></option>
            }
        </datalist>
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-primary" type="submit">Visa statistik</button>
    </div>
</form>

@if (stats is not null)
{
    <h2 class="h5">@stats.ExerciseName</h2>
    <table class="table w-auto">
        <tbody>
            <tr><th>Högsta vikt</th><td>@Formatter.FormatWeight(stats.MaxWeight)</td></tr>
            <tr><th>Totalt antal set</th><td>@stats.TotalSets</td></tr>
        </tbody>
    </table>
}

@code {
    private string name = "";
    private List<string> exerciseNames = new();
    private ExerciseStats? stats;

    // Övningar som finns i passen, som förslag i sökrutan.
    protected override void OnInitialized() =>
        exerciseNames = TryGet(Repository.GetAllWorkouts, new List<Workout>())
            .SelectMany(w => w.Exercises)
            .Select(e => e.Name)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Order()
            .ToList();

    private void ShowStats()
    {
        stats = null;
        if (string.IsNullOrWhiteSpace(name))
        {
            ClearMessages();
            ErrorMessage = "Skriv namnet på en övning.";
            return;
        }

        stats = TryGet<ExerciseStats?>(() => Statistics.GetExerciseStats(name.Trim()), null);
    }
}
