@page "/overview"
@inherits PageBase
@inject IStatisticsService Statistics
@inject IWorkoutFormatter Formatter

<PageTitle>Veckoöversikt</PageTitle>

<h1>Veckoöversikt@(overview is not null ? $", vecka {overview.Week}" : "")</h1>
<p class="text-muted">Veckan börjar på måndag och slutar på söndag.</p>

<PageMessages NotImplemented="NotImplemented" Success="@SuccessMessage" Warning="@WarningMessage" Error="@ErrorMessage" />

<WeekPicker OnWeekSelected="LoadWeek" />

@if (overview is not null)
{
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card"><div class="card-body">
                <div class="text-muted">Antal pass</div>
                <div class="fs-3">@overview.WorkoutCount</div>
            </div></div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card"><div class="card-body">
                <div class="text-muted">Total träningstid</div>
                <div class="fs-3">@Formatter.FormatDuration(overview.TotalMinutes)</div>
            </div></div>
        </div>
    </div>

    <h2 class="h5">Träningstid per träningstyp</h2>
    @if (overview.MinutesPerType.Count == 0)
    {
        <p>Inga pass den här veckan.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr><th>Träningstyp</th><th>Träningstid</th><th>Veckomål</th></tr>
            </thead>
            <tbody>
                @foreach (TrainingTypeMinutes row in overview.MinutesPerType)
                {
                    <tr>
                        <td>@row.TrainingTypeName</td>
                        <td>@Formatter.FormatDuration(row.Minutes)</td>
                        <td>@(row.GoalMinutes is int goal ? Formatter.FormatDuration(goal) : "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private WeekOverview? overview;

    private void LoadWeek((int Year, int Week) selected) =>
        overview = TryGet<WeekOverview?>(() => Statistics.GetWeekOverview(selected.Year, selected.Week), null);
}
