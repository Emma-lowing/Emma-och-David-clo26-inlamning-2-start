@* Val av år och månad. Används av transaktioner, månadsöversikt och budget. *@

<form class="row g-2 align-items-end mb-3" @onsubmit="Submit">
    <div class="col-auto">
        <button type="button" class="btn btn-outline-secondary" title="Föregående månad" @onclick="() => Step(-1)">&laquo;</button>
    </div>
    <div class="col-auto">
        <label class="form-label" for="year">År</label>
        <input id="year" class="form-control" style="width:7rem" @bind="yearText" />
    </div>
    <div class="col-auto">
        <label class="form-label" for="month">Månad</label>
        <select id="month" class="form-select" @bind="monthText">
            @for (int m = 1; m <= 12; m++)
            {
                <option value="@m">@(new DateOnly(2000, m, 1).ToString("MMMM"))</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Visa</button>
    </div>
    <div class="col-auto">
        <button type="button" class="btn btn-outline-secondary" title="Nästa månad" @onclick="() => Step(1)">&raquo;</button>
    </div>
    @if (error is not null)
    {
        <div class="col-12 text-danger">@error</div>
    }
</form>

@code {
    /// <summary>Anropas med (år, månad) när användaren valt en giltig månad.</summary>
    [Parameter] public EventCallback<(int Year, int Month)> OnMonthSelected { get; set; }

    private string yearText = "";
    private string monthText = "";
    private string? error;

    // Utan val visas innevarande månad.
    protected override async Task OnInitializedAsync()
    {
        yearText = DateTime.Today.Year.ToString();
        monthText = DateTime.Today.Month.ToString();
        await Submit();
    }

    private async Task Submit()
    {
        error = null;
        if (!InputParser.TryParseInt(yearText, 2000, 2100, out int year) ||
            !InputParser.TryParseInt(monthText, 1, 12, out int month))
        {
            error = "Skriv ett år mellan 2000 och 2100 och välj en månad.";
            return;
        }
        await OnMonthSelected.InvokeAsync((year, month));
    }

    private async Task Step(int months)
    {
        if (!InputParser.TryParseInt(yearText, 2000, 2100, out int year) ||
            !InputParser.TryParseInt(monthText, 1, 12, out int month))
        {
            error = "Skriv ett år mellan 2000 och 2100 och välj en månad.";
            return;
        }

        DateOnly selected = new DateOnly(year, month, 1).AddMonths(months);
        yearText = selected.Year.ToString();
        monthText = selected.Month.ToString();
        await Submit();
    }
}
