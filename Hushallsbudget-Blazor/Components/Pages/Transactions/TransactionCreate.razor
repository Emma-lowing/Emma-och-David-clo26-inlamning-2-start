@page "/transactions/create"
@inherits PageBase
@inject IHouseholdRepository Repository
@inject ICategoryService CategoryService
@inject IBudgetWarningService Warnings

<PageTitle>Lägg till transaktion</PageTitle>

<h1>Lägg till transaktion</h1>

<PageMessages NotImplemented="NotImplemented" Success="@SuccessMessage" Warning="@WarningMessage" Error="@ErrorMessage" />

@if (validationErrors.Count > 0)
{
    <ul class="text-danger">
        @foreach (string error in validationErrors)
        {
            <li>@error</li>
        }
    </ul>
}

<form class="col-md-6" @onsubmit="Save">
    <div class="mb-3">
        <label class="form-label" for="type">Typ</label>
        <select id="type" class="form-select" @bind="type">
            <option value="@Expense">Utgift</option>
            <option value="@Income">Inkomst</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label" for="amount">Belopp i kronor</label>
        <input id="amount" class="form-control" @bind="amountText" placeholder="249,50" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="date">Datum</label>
        <input id="date" type="date" class="form-control" @bind="date" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="category">Kategori</label>
        <select id="category" class="form-select" @bind="category">
            <option value="">Välj kategori</option>
            @foreach (Category c in categories)
            {
                <option value="@c.Name">@c.Name</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label" for="note">Anteckning (valfri)</label>
        <input id="note" class="form-control" @bind="note" placeholder="ICA" />
    </div>

    <button type="submit" class="btn btn-primary">Spara</button>
    <a class="btn btn-link" href="transactions">Till transaktionerna</a>
</form>

@code {
    private const string Expense = "expense";
    private const string Income = "income";

    private List<Category> categories = new();
    private List<string> validationErrors = new();

    // Formuläret binder till text, så att felaktig inmatning, till exempel "abc", ger ett meddelande.
    private string type = Expense;
    private string amountText = "";
    private DateOnly? date = DateOnly.FromDateTime(DateTime.Today);
    private string category = "";
    private string note = "";

    protected override void OnInitialized() =>
        categories = TryGet(CategoryService.GetAll, new List<Category>());

    private void Save()
    {
        ClearMessages();
        validationErrors.Clear();

        if (!InputParser.TryParseDecimal(amountText, out decimal amount))
        {
            validationErrors.Add($"\"{amountText}\" är inget giltigt belopp. Skriv till exempel 249,50.");
        }
        else if (amount <= 0)
        {
            validationErrors.Add("Beloppet måste vara större än 0.");
        }
        if (date is null)
        {
            validationErrors.Add("Skriv ett datum.");
        }
        if (string.IsNullOrWhiteSpace(category))
        {
            validationErrors.Add("Välj en kategori.");
        }

        if (validationErrors.Count > 0)
        {
            return;
        }

        // Du behöver bygga ut detta mer: i låtsasdatan är en utgift ett negativt belopp, som i
        // Carlos Excel-ark. Ger ni Transaction ett eget fält för inkomst eller utgift, ändra här.
        var transaction = new Transaction
        {
            Amount = type == Expense ? -amount : amount,
            Date = date!.Value,
            Category = category,
            Note = note.Trim(),
        };

        if (TryRun(() => Repository.AddTransaction(transaction)))
        {
            SuccessMessage = $"Transaktionen är sparad ({transaction.Category}, {transaction.Date:yyyy-MM-dd}).";
            WarningMessage = BudgetWarnings(transaction);
            amountText = "";
            note = "";
        }
    }

    // Transaktionen är redan sparad när varningarna kontrolleras. Om varningarna inte är byggda än
    // visas en upplysning i stället för "Inte implementerat ännu".
    private string? BudgetWarnings(Transaction transaction)
    {
        try
        {
            List<string> warnings = Warnings.CheckBudget(transaction);
            return warnings.Count > 0 ? string.Join(" ", warnings) : null;
        }
        catch (NotImplementedException)
        {
            return "Budgetvarningar är inte implementerade ännu. Dem ska ni bygga i BudgetWarningService.";
        }
    }
}
