@page "/transactions"
@inherits PageBase
@inject IHouseholdRepository Repository
@inject IMoneyFormatter Formatter

<PageTitle>Transaktioner</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Transaktioner@(month > 0 ? $", {MonthName}" : "")</h1>
    <a class="btn btn-primary" href="transactions/create">Lägg till transaktion</a>
</div>

<PageMessages NotImplemented="NotImplemented" Success="@SuccessMessage" Warning="@WarningMessage" Error="@ErrorMessage" />

<MonthPicker OnMonthSelected="LoadMonth" />

@if (transactions.Count == 0)
{
    <p>Det finns inga transaktioner den månaden.</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Datum</th><th>Kategori</th><th>Anteckning</th><th class="text-end">Belopp</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (Transaction transaction in transactions)
            {
                <tr>
                    <td>@transaction.Date.ToString("yyyy-MM-dd")</td>
                    <td>@transaction.Category</td>
                    <td>@transaction.Note</td>
                    @* Du behöver bygga ut detta mer: önskemål 1 säger att en utgift visas som ett positivt
                       belopp under Utgifter. Visa tydligt om raden är en inkomst eller en utgift. *@
                    <td class="text-end">@Formatter.Format(transaction.Amount)</td>
                    <td class="text-end">
                        @if (pendingDelete?.Id == transaction.Id)
                        {
                            @* Önskemål 5: bekräfta innan något tas bort. "Nej" lämnar allt oförändrat. *@
                            <span class="me-2">Är du säker?</span>
                            <button class="btn btn-sm btn-danger" @onclick="ConfirmDelete">Ja, ta bort</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelDelete">Nej</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => pendingDelete = transaction">Ta bort</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private int year;
    private int month;
    private List<Transaction> transactions = new();
    private Transaction? pendingDelete;

    private string MonthName => new DateOnly(year, month, 1).ToString("MMMM yyyy");

    private void LoadMonth((int Year, int Month) selected)
    {
        (year, month) = selected;
        pendingDelete = null;
        transactions = TryGet(() => Repository.GetTransactionsForMonth(year, month), new List<Transaction>());
    }

    private void ConfirmDelete()
    {
        Transaction transaction = pendingDelete!;
        pendingDelete = null;

        if (TryRun(() => Repository.DeleteTransaction(transaction.Id)))
        {
            transactions = TryGet(() => Repository.GetTransactionsForMonth(year, month), new List<Transaction>());
            SuccessMessage = "Transaktionen är borttagen.";
        }
    }

    private void CancelDelete() => pendingDelete = null;
}
