@page "/budget"
@inherits PageBase
@inject IBudgetService BudgetService
@inject ICategoryService CategoryService
@inject IMoneyFormatter Formatter

<PageTitle>Budget</PageTitle>

<h1>Budget@(month > 0 ? $", {MonthName}" : "")</h1>

<PageMessages NotImplemented="NotImplemented" Success="@SuccessMessage" Warning="@WarningMessage" Error="@ErrorMessage" />

<MonthPicker OnMonthSelected="LoadMonth" />

@if (statuses.Count == 0)
{
    <p>Ingen kategori har en budget den månaden.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr><th>Kategori</th><th class="text-end">Använt</th><th class="text-end">Budget</th><th style="width:30%"></th><th>Status</th></tr>
        </thead>
        <tbody>
            @foreach (BudgetStatus status in statuses)
            {
                <tr>
                    <td>@status.CategoryName</td>
                    <td class="text-end">@Formatter.Format(status.Spent)</td>
                    <td class="text-end">@Formatter.Format(status.BudgetAmount)</td>
                    <td>
                        <div class="progress" role="progressbar" aria-label="@status.CategoryName" aria-valuenow="@status.Percent" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar @BarClass(status.Level)" style="width:@(Math.Min(status.Percent, 100))%">@status.Percent %</div>
                        </div>
                    </td>
                    <td>
                        @if (status.Level == BudgetLevel.Exceeded)
                        {
                            <span class="text-danger">@status.CategoryName är över budgeten</span>
                        }
                        else if (status.Level == BudgetLevel.Warning)
                        {
                            <span class="text-warning-emphasis">@status.CategoryName är på @status.Percent % av budgeten</span>
                        }
                        else
                        {
                            <span class="text-muted">OK</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h2 class="h5 mt-4">Sätt budget@(month > 0 ? $" för {MonthName}" : "")</h2>
<form class="row g-2 align-items-end" @onsubmit="SetBudget">
    <div class="col-auto">
        <label class="form-label" for="budgetCategory">Kategori</label>
        <select id="budgetCategory" class="form-select" @bind="selectedCategoryId">
            @foreach (Category category in categories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label" for="budgetAmount">Budget i kronor</label>
        <input id="budgetAmount" class="form-control" @bind="amountText" placeholder="1000" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Spara</button>
    </div>
</form>

@code {
    private int year;
    private int month;
    private List<BudgetStatus> statuses = new();
    private List<Category> categories = new();
    private int selectedCategoryId;
    private string amountText = "";

    private string MonthName => new DateOnly(year, month, 1).ToString("MMMM yyyy");

    protected override void OnInitialized()
    {
        categories = TryGet(CategoryService.GetAll, new List<Category>());
        selectedCategoryId = categories.FirstOrDefault()?.Id ?? 0;
    }

    private void LoadMonth((int Year, int Month) selected)
    {
        (year, month) = selected;
        statuses = TryGet(() => BudgetService.GetBudgetStatus(year, month), new List<BudgetStatus>());
    }

    private void SetBudget()
    {
        if (!InputParser.TryParseDecimal(amountText, out decimal amount))
        {
            ClearMessages();
            ErrorMessage = "Budgeten måste vara ett tal, till exempel 1000.";
            return;
        }

        if (TryRun(() => BudgetService.SetBudget(selectedCategoryId, year, month, amount)))
        {
            LoadMonth((year, month));
            SuccessMessage = "Budgeten är sparad.";
            amountText = "";
        }
    }

    private static string BarClass(BudgetLevel level) => level switch
    {
        BudgetLevel.Exceeded => "bg-danger",
        BudgetLevel.Warning => "bg-warning",
        _ => "bg-success",
    };
}
