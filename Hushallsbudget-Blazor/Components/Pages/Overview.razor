@page "/overview"
@inherits PageBase
@inject IMonthlyOverviewService OverviewService
@inject IMoneyFormatter Formatter

<PageTitle>Månadsöversikt</PageTitle>

<h1>Månadsöversikt@(overview is not null ? $", {MonthName}" : "")</h1>

<PageMessages NotImplemented="NotImplemented" Success="@SuccessMessage" Warning="@WarningMessage" Error="@ErrorMessage" />

<MonthPicker OnMonthSelected="LoadMonth" />

@if (overview is not null)
{
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card h-100"><div class="card-body">
                <h2 class="h6 card-title text-muted">Inkomster</h2>
                <p class="fs-4 mb-0">@Formatter.Format(overview.TotalIncome)</p>
            </div></div>
        </div>
        <div class="col-md-4">
            <div class="card h-100"><div class="card-body">
                <h2 class="h6 card-title text-muted">Utgifter</h2>
                <p class="fs-4 mb-0">@Formatter.Format(overview.TotalExpenses)</p>
            </div></div>
        </div>
        <div class="col-md-4">
            <div class="card h-100"><div class="card-body">
                <h2 class="h6 card-title text-muted">Saldo</h2>
                <p class="fs-4 mb-0">@Formatter.Format(overview.Balance)</p>
            </div></div>
        </div>
    </div>

    <h2 class="h5">Utgifter per kategori</h2>
    @if (overview.CategoryTotals.Count == 0)
    {
        <p>Inga utgifter den månaden.</p>
    }
    else
    {
        <table class="table">
            <tbody>
                @foreach (CategoryTotal total in overview.CategoryTotals)
                {
                    <tr>
                        <td>@total.CategoryName</td>
                        <td class="text-end">@Formatter.Format(total.Amount)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private MonthlyOverview? overview;

    private string MonthName => new DateOnly(overview!.Year, overview.Month, 1).ToString("MMMM yyyy");

    private void LoadMonth((int Year, int Month) selected) =>
        overview = TryGet<MonthlyOverview?>(() => OverviewService.GetOverview(selected.Year, selected.Month), null);
}
