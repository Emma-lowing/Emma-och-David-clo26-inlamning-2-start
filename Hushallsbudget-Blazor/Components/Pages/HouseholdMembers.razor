@page "/household"
@inherits PageBase
@inject IHouseholdRepository Repository

<PageTitle>Hushållet</PageTitle>

<h1>@(household?.Name ?? "Hushållet")</h1>

<PageMessages NotImplemented="NotImplemented" Success="@SuccessMessage" Warning="@WarningMessage" Error="@ErrorMessage" />

<p class="text-muted">Ett hushåll har 1–5 medlemmar.</p>

@if (members.Count == 0)
{
    <p>Hushållet har inga medlemmar än.</p>
}
else
{
    <ul class="list-group mb-4">
        @foreach (Member member in members)
        {
            <li class="list-group-item">@member.FirstName @member.LastName</li>
        }
    </ul>
}

<h2 class="h5">Lägg till medlem</h2>

@* Fälten följer modellen Member. Tar ni bort ett fält ur modellen, ta bort raden här också. *@
<form class="col-md-6" @onsubmit="AddMember">
    <div class="mb-3">
        <label class="form-label" for="firstName">Förnamn</label>
        <input id="firstName" class="form-control" @bind="newMember.FirstName" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="lastName">Efternamn</label>
        <input id="lastName" class="form-control" @bind="newMember.LastName" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="birthDate">Födelsedatum</label>
        <input id="birthDate" type="date" class="form-control" @bind="newMember.BirthDate" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="hairColor">Hårfärg</label>
        <input id="hairColor" class="form-control" @bind="newMember.HairColor" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="height">Längd i cm</label>
        <input id="height" class="form-control" @bind="heightText" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="religion">Religion</label>
        <input id="religion" class="form-control" @bind="newMember.Religion" />
    </div>

    <button type="submit" class="btn btn-primary">Spara</button>
</form>

@code {
    private Household? household;
    private List<Member> members = new();
    private Member newMember = new();
    private string heightText = "";

    protected override void OnInitialized()
    {
        household = TryGet<Household?>(Repository.GetHousehold, null);
        LoadMembers();
    }

    private void LoadMembers() => members = TryGet(Repository.GetAllMembers, new List<Member>());

    private void AddMember()
    {
        ClearMessages();
        if (string.IsNullOrWhiteSpace(newMember.FirstName))
        {
            ErrorMessage = "Medlemmen måste ha ett förnamn.";
            return;
        }
        if (heightText.Length > 0)
        {
            if (!InputParser.TryParseInt(heightText, 0, 300, out int height))
            {
                ErrorMessage = "Längden måste vara ett heltal mellan 0 och 300.";
                return;
            }
            newMember.HeightCm = height;
        }

        Member added = newMember;
        if (TryRun(() => Repository.AddMember(added)))
        {
            LoadMembers();
            SuccessMessage = $"{added.FirstName} är tillagd i hushållet.";
            newMember = new Member();
            heightText = "";
        }
    }
}
