@model Transaction
@{
    ViewData["Title"] = "Ta bort transaktion";
}

<h1>Ta bort transaktion</h1>

<div class="alert alert-warning">
    <p class="mb-2"><strong>Är du säker?</strong></p>
    <p class="mb-0">
        @Model.Date.ToString("yyyy-MM-dd"), @Model.Category: @ViewData["AmountText"]
        @if (Model.Note.Length > 0)
        {
            <span>(@Model.Note)</span>
        }
    </p>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Ja, ta bort</button>
    <a class="btn btn-outline-secondary" asp-action="Index" asp-route-year="@Model.Date.Year" asp-route-month="@Model.Date.Month">Nej, avbryt</a>
</form>
