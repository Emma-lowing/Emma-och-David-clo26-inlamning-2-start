@using Microsoft.AspNetCore.Mvc.Rendering
@model TransactionFormModel
@{
    ViewData["Title"] = "Lägg till transaktion";
    var categories = (List<SelectListItem>)ViewData["Categories"]!;
}

<h1>Lägg till transaktion</h1>

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <span class="form-label d-block">Typ</span>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" asp-for="Type" id="typeExpense" value="@TransactionFormModel.Expense" />
            <label class="form-check-label" for="typeExpense">Utgift</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" asp-for="Type" id="typeIncome" value="@TransactionFormModel.Income" />
            <label class="form-check-label" for="typeIncome">Inkomst</label>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Amount" class="form-label">Belopp i kronor</label>
        @* type="text" så att felaktig inmatning, till exempel "abc", ger ett meddelande. *@
        <input asp-for="Amount" type="text" class="form-control" placeholder="249,50" />
    </div>
    <div class="mb-3">
        <label asp-for="Date" class="form-label"></label>
        <input asp-for="Date" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Category" class="form-label"></label>
        <select asp-for="Category" asp-items="categories" class="form-select">
            <option value="">Välj kategori</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Note" class="form-label">Anteckning (valfri)</label>
        <input asp-for="Note" class="form-control" placeholder="ICA" />
    </div>

    <button type="submit" class="btn btn-primary">Spara</button>
    <a class="btn btn-link" asp-action="Index">Avbryt</a>
</form>
