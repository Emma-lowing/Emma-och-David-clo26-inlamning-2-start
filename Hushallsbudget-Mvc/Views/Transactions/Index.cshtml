@model TransactionListViewModel
@{
    ViewData["Title"] = "Transaktioner";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Transaktioner, @Model.MonthName</h1>
    <a class="btn btn-primary" asp-action="Create">Lägg till transaktion</a>
</div>

<partial name="_MonthPicker" model="Model" />

@if (Model.Transactions.Count == 0)
{
    <p>Det finns inga transaktioner den månaden.</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Datum</th><th>Kategori</th><th>Anteckning</th><th class="text-end">Belopp</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (TransactionLine line in Model.Transactions)
            {
                <tr>
                    <td>@line.Date.ToString("yyyy-MM-dd")</td>
                    <td>@line.Category</td>
                    <td>@line.Note</td>
                    @* Du behöver bygga ut detta mer: önskemål 1 säger att en utgift visas som ett positivt
                       belopp under Utgifter. Visa tydligt om raden är en inkomst eller en utgift. *@
                    <td class="text-end">@line.AmountText</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@line.Id">Ta bort</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
