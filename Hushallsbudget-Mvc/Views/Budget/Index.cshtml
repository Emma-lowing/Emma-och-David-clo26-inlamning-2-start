@model BudgetViewModel
@{
    ViewData["Title"] = "Budget";
}

<h1>Budget, @Model.MonthName</h1>

<partial name="_MonthPicker" model="Model" />

@if (Model.Lines.Count == 0)
{
    <p>Ingen kategori har en budget den månaden.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr><th>Kategori</th><th class="text-end">Använt</th><th class="text-end">Budget</th><th style="width:30%"></th><th>Status</th></tr>
        </thead>
        <tbody>
            @foreach (BudgetLine line in Model.Lines)
            {
                string barClass = line.Level switch
                {
                    BudgetLevel.Exceeded => "bg-danger",
                    BudgetLevel.Warning => "bg-warning",
                    _ => "bg-success",
                };
                <tr>
                    <td>@line.CategoryName</td>
                    <td class="text-end">@line.SpentText</td>
                    <td class="text-end">@line.BudgetText</td>
                    <td>
                        <div class="progress" role="progressbar" aria-label="@line.CategoryName" aria-valuenow="@line.Percent" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar @barClass" style="width:@(Math.Min(line.Percent, 100))%">@line.Percent %</div>
                        </div>
                    </td>
                    <td>
                        @if (line.Level == BudgetLevel.Exceeded)
                        {
                            <span class="text-danger">@line.CategoryName är över budgeten</span>
                        }
                        else if (line.Level == BudgetLevel.Warning)
                        {
                            <span class="text-warning-emphasis">@line.CategoryName är på @line.Percent % av budgeten</span>
                        }
                        else
                        {
                            <span class="text-muted">OK</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h2 class="h5 mt-4">Sätt budget för @Model.MonthName</h2>
<form asp-action="SetBudget" method="post" class="row g-2 align-items-end">
    <input type="hidden" name="year" value="@Model.Year" />
    <input type="hidden" name="month" value="@Model.Month" />
    <div class="col-auto">
        <label for="categoryId" class="form-label">Kategori</label>
        <select id="categoryId" name="categoryId" class="form-select" asp-items="Model.Categories"></select>
    </div>
    <div class="col-auto">
        <label for="amount" class="form-label">Budget i kronor</label>
        <input id="amount" name="amount" type="text" class="form-control" placeholder="1000" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Spara</button>
    </div>
</form>
