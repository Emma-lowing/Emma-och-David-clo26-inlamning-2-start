@model List<Member>
@{
    ViewData["Title"] = "Hushållet";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@ViewData["HouseholdName"]</h1>
    <a class="btn btn-primary" asp-action="AddMember">Lägg till medlem</a>
</div>

<p class="text-muted">Ett hushåll har 1–5 medlemmar.</p>

@if (Model.Count == 0)
{
    <p>Hushållet har inga medlemmar än.</p>
}
else
{
    <ul class="list-group">
        @foreach (Member member in Model)
        {
            <li class="list-group-item">@member.FirstName @member.LastName</li>
        }
    </ul>
}
