@model OverviewViewModel
@{
    ViewData["Title"] = "Månadsöversikt";
}

<h1>Månadsöversikt, @Model.MonthName</h1>

<partial name="_MonthPicker" model="Model" />

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
            <h2 class="h6 card-title text-muted">Inkomster</h2>
            <p class="fs-4 mb-0">@Model.IncomeText</p>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
            <h2 class="h6 card-title text-muted">Utgifter</h2>
            <p class="fs-4 mb-0">@Model.ExpensesText</p>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
            <h2 class="h6 card-title text-muted">Saldo</h2>
            <p class="fs-4 mb-0">@Model.BalanceText</p>
        </div></div>
    </div>
</div>

<h2 class="h5">Utgifter per kategori</h2>
@if (Model.CategoryLines.Count == 0)
{
    <p>Inga utgifter den månaden.</p>
}
else
{
    <table class="table">
        <tbody>
            @foreach (var line in Model.CategoryLines)
            {
                <tr>
                    <td>@line.CategoryName</td>
                    <td class="text-end">@line.AmountText</td>
                </tr>
            }
        </tbody>
    </table>
}
