@model MonthViewModel
@* Val av år och månad. Används av transaktioner, månadsöversikt och budget. *@
<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <a class="btn btn-outline-secondary" asp-route-year="@Model.PreviousMonth.Year" asp-route-month="@Model.PreviousMonth.Month" title="Föregående månad">&laquo;</a>
    </div>
    <div class="col-auto">
        <label for="year" class="form-label">År</label>
        <input id="year" name="year" type="number" min="2000" max="2100" value="@Model.Year" class="form-control" style="width:7rem" />
    </div>
    <div class="col-auto">
        <label for="month" class="form-label">Månad</label>
        <select id="month" name="month" class="form-select">
            @for (int m = 1; m <= 12; m++)
            {
                <option value="@m" selected="@(m == Model.Month)">@(new DateOnly(2000, m, 1).ToString("MMMM"))</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Visa</button>
    </div>
    <div class="col-auto">
        <a class="btn btn-outline-secondary" asp-route-year="@Model.NextMonth.Year" asp-route-month="@Model.NextMonth.Month" title="Nästa månad">&raquo;</a>
    </div>
</form>
