@model WeekViewModel
@{
    ViewData["Title"] = "Inköpslista";
}

<h1>Inköpslista, vecka @Model.Week</h1>

<partial name="_WeekPicker" model="Model" />

@if (Model.ShoppingLines.Count == 0)
{
    <p>Inköpslistan är tom.</p>
}
else
{
    <ul>
        @foreach (string line in Model.ShoppingLines)
        {
            <li>@line</li>
        }
    </ul>
}

<a class="btn btn-outline-secondary" asp-action="Index" asp-route-year="@Model.Year" asp-route-week="@Model.Week">Till veckoplanen</a>
