@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Planera en måltid";
    var recipes = (List<SelectListItem>)ViewData["Recipes"]!;
}

<h1>Planera en måltid</h1>

<form asp-action="Plan" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label for="recipeId" class="form-label">Recept</label>
        <select id="recipeId" name="recipeId" class="form-select" asp-items="recipes"></select>
    </div>
    <div class="mb-3">
        <label for="date" class="form-label">Datum</label>
        <input id="date" name="date" type="date" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Planera</button>
    <a class="btn btn-link" asp-action="Index">Avbryt</a>
</form>
