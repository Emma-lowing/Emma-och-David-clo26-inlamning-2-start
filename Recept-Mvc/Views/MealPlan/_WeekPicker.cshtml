@model WeekViewModel
@* Val av år och vecka. Används av både veckoplanen och inköpslistan. *@
<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label for="year" class="form-label">År</label>
        <input id="year" name="year" type="number" min="2000" max="2100" value="@Model.Year" class="form-control" />
    </div>
    <div class="col-auto">
        <label for="week" class="form-label">Vecka</label>
        <input id="week" name="week" type="number" min="1" max="53" value="@Model.Week" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Visa</button>
    </div>
</form>
