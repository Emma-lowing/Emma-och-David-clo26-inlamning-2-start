@model WeekViewModel
@{
    ViewData["Title"] = "Veckoplan";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Veckoplan, vecka @Model.Week</h1>
    <a class="btn btn-primary" asp-action="Plan">Planera en måltid</a>
</div>

<partial name="_WeekPicker" model="Model" />

@if (Model.Meals.Count == 0)
{
    <p>Inga måltider är planerade den här veckan.</p>
}
else
{
    <table class="table">
        <tbody>
            @foreach (var meal in Model.Meals)
            {
                <tr>
                    <td style="width:14rem">@meal.Date.ToString("dddd d MMMM")</td>
                    <td>@meal.RecipeName</td>
                </tr>
            }
        </tbody>
    </table>
}

<a class="btn btn-outline-secondary" asp-action="ShoppingList" asp-route-year="@Model.Year" asp-route-week="@Model.Week">Inköpslista för veckan</a>
