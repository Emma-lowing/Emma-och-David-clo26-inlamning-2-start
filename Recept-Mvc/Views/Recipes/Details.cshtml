@model RecipeDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
}

<h1>@Model.Name</h1>
<p class="text-muted">
    @Model.Servings portioner
    @if (Model.Servings != Model.OriginalServings)
    {
        <span>(receptet är skrivet för @Model.OriginalServings)</span>
    }
</p>

<ul>
    @foreach (string line in Model.IngredientLines)
    {
        <li>@line</li>
    }
</ul>

@* Du behöver bygga ut detta mer: visa kategori, kock och anteckning. *@

<form method="get" asp-action="Details" asp-route-id="@Model.Id" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label for="servings" class="form-label">Visa för antal portioner</label>
        <input id="servings" name="servings" type="number" min="1" max="100" value="@Model.Servings" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Räkna om</button>
    </div>
</form>

<a class="btn btn-link" asp-action="Index">Tillbaka till recepten</a>
