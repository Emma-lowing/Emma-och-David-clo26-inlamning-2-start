@model List<Recipe>
@{
    ViewData["Title"] = "Recept";
    string? search = ViewData["Search"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Recept</h1>
    <a class="btn btn-primary" asp-action="Create">Lägg till recept</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input class="form-control" name="search" value="@search" placeholder="Sök på ingrediens" />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-primary" type="submit">Sök</button>
        @if (!string.IsNullOrEmpty(search))
        {
            <a class="btn btn-link" asp-action="Index">Visa alla</a>
        }
    </div>
</form>

@if (Model.Count == 0)
{
    <p>@(string.IsNullOrEmpty(search) ? "Det finns inga recept än." : "Inga recept hittades.")</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Namn</th><th>Portioner</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (Recipe recipe in Model)
            {
                <tr>
                    <td>@recipe.Name</td>
                    <td>@recipe.Servings</td>
                    @* Du behöver bygga ut detta mer: visa kategori och kock när modellen har dem. *@
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@recipe.Id">Visa</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@recipe.Id">Ta bort</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
