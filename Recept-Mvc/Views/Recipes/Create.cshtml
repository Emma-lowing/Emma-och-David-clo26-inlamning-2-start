@model RecipeFormModel
@{
    ViewData["Title"] = "Lägg till recept";
}

<h1>Lägg till recept</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
        </div>
        <div class="col-md-2">
            <label asp-for="Servings" class="form-label"></label>
            <input asp-for="Servings" class="form-control" />
        </div>
    </div>

    @* Du behöver bygga ut detta mer: fält för kategori, kock och anteckning när modellen Recipe har dem. *@

    <h2 class="h5">Ingredienser</h2>
    <p class="text-muted">Fyll i så många rader du behöver. Tomma rader hoppas över.</p>

    <table class="table table-sm">
        <thead>
            <tr><th>Ingrediens</th><th style="width:10rem">Mängd</th><th style="width:10rem">Enhet</th></tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Ingredients.Count; i++)
            {
                <tr>
                    <td><input asp-for="Ingredients[i].Name" class="form-control" placeholder="vetemjöl" /></td>
                    @* type="text" så att både 2,5 och 2.5 går att skriva. *@
                    <td><input asp-for="Ingredients[i].Amount" type="text" class="form-control" placeholder="2,5" /></td>
                    <td><input asp-for="Ingredients[i].Unit" class="form-control" placeholder="dl" /></td>
                </tr>
            }
        </tbody>
    </table>

    <button type="submit" class="btn btn-primary">Spara</button>
    <a class="btn btn-link" asp-action="Index">Avbryt</a>
</form>
