@model List<Category>
@{
    ViewData["Title"] = "Kategorier";
}

<h1>Kategorier</h1>

<table class="table">
    <thead>
        <tr><th>Namn</th><th>Gräns per vecka</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (Category category in Model)
        {
            <tr>
                <td>@category.Name</td>
                <td>
                    @* Du behöver bygga ut detta mer: visa nuvarande gräns när Category har det fältet. *@
                    <form asp-action="SetLimit" method="post" class="d-flex gap-2">
                        <input type="hidden" name="id" value="@category.Id" />
                        <input type="number" name="maxPerWeek" min="1" max="21" class="form-control form-control-sm" style="width:6rem" required />
                        <button type="submit" class="btn btn-sm btn-outline-primary">Spara</button>
                    </form>
                </td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@category.Id">Ta bort</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<h2 class="h5 mt-4">Lägg till kategori</h2>
<form asp-action="Create" method="post" class="row g-2">
    <div class="col-auto">
        <input name="name" class="form-control" placeholder="Till exempel Grill" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Lägg till</button>
    </div>
</form>
