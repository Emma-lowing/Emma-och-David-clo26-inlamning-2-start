@model Chef
@{
    ViewData["Title"] = "Lägg till kock";
}

<h1>Lägg till kock</h1>

@* Fälten följer modellen Chef. Tar ni bort ett fält ur modellen, ta bort raden här också. *@
<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="FirstName" class="form-label">Förnamn</label>
        <input asp-for="FirstName" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="LastName" class="form-label">Efternamn</label>
        <input asp-for="LastName" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="BirthDate" class="form-label">Födelsedatum</label>
        <input asp-for="BirthDate" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="HairColor" class="form-label">Hårfärg</label>
        <input asp-for="HairColor" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="HeightCm" class="form-label">Längd i cm</label>
        <input asp-for="HeightCm" type="number" min="0" max="300" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Religion" class="form-label">Religion</label>
        <input asp-for="Religion" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Spara</button>
    <a class="btn btn-link" asp-action="Index">Avbryt</a>
</form>
