@model List<Athlete>
@{
    ViewData["Title"] = "Utövare";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Utövare</h1>
    <a class="btn btn-primary" asp-action="Create">Lägg till utövare</a>
</div>

@if (Model.Count == 0)
{
    <p>Det finns inga utövare än.</p>
}
else
{
    <ul class="list-group">
        @foreach (Athlete athlete in Model)
        {
            <li class="list-group-item">@athlete.FirstName @athlete.LastName</li>
        }
    </ul>
}
