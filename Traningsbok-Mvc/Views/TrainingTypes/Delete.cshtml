@model TrainingType
@{
    ViewData["Title"] = "Ta bort träningstyp";
}

<h1>Ta bort träningstyp</h1>

<div class="alert alert-warning">
    Vill du ta bort <strong>@Model.Name</strong>? Passen med träningstypen flyttas till "Övrigt".
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Ja, ta bort</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Nej, avbryt</a>
</form>
