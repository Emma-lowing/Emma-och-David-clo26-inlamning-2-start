@model List<TrainingType>
@{
    ViewData["Title"] = "Träningstyper";
}

<h1>Träningstyper</h1>

<table class="table">
    <thead>
        <tr><th>Namn</th><th>Veckomål i minuter</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (TrainingType trainingType in Model)
        {
            <tr>
                <td>@trainingType.Name</td>
                <td>
                    @* Du behöver bygga ut detta mer: visa nuvarande veckomål när TrainingType har det fältet. *@
                    <form asp-action="SetGoal" method="post" class="d-flex gap-2">
                        <input type="hidden" name="id" value="@trainingType.Id" />
                        <input type="number" name="minutes" min="1" max="10080" class="form-control form-control-sm" style="width:7rem" required />
                        <button type="submit" class="btn btn-sm btn-outline-primary">Spara</button>
                    </form>
                </td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@trainingType.Id">Ta bort</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<h2 class="h5 mt-4">Lägg till träningstyp</h2>
<form asp-action="Create" method="post" class="row g-2">
    <div class="col-auto">
        <input name="name" class="form-control" placeholder="Till exempel Klättring" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Lägg till</button>
    </div>
</form>
