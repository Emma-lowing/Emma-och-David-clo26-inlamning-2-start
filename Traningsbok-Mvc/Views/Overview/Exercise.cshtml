@model ExerciseStatsViewModel
@{
    ViewData["Title"] = "Övningsstatistik";
}

<h1>Statistik för en övning</h1>
<p class="text-muted">Högsta vikt och totalt antal set, i alla pass.</p>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input class="form-control" name="name" value="@Model.Name" list="exercise-names" placeholder="Till exempel Knäböj" required />
        <datalist id="exercise-names">
            @foreach (string exerciseName in Model.ExerciseNames)
            {
                <option value="@exerciseName"></option>
            }
        </datalist>
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-primary" type="submit">Visa statistik</button>
    </div>
</form>

@if (Model.HasResult)
{
    <h2 class="h5">@Model.Name</h2>
    <table class="table w-auto">
        <tbody>
            <tr><th>Högsta vikt</th><td>@Model.MaxWeight</td></tr>
            <tr><th>Totalt antal set</th><td>@Model.TotalSets</td></tr>
        </tbody>
    </table>
}
