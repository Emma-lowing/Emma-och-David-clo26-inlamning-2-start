@model WeekViewModel
@{
    ViewData["Title"] = "Veckoöversikt";
}

<h1>Veckoöversikt, vecka @Model.Week</h1>
<p class="text-muted">Veckan börjar på måndag och slutar på söndag.</p>

<partial name="_WeekPicker" model="Model" />

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card"><div class="card-body">
            <div class="text-muted">Antal pass</div>
            <div class="fs-3">@Model.WorkoutCount</div>
        </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card"><div class="card-body">
            <div class="text-muted">Total träningstid</div>
            <div class="fs-3">@Model.TotalTime</div>
        </div></div>
    </div>
</div>

<h2 class="h5">Träningstid per träningstyp</h2>
@if (Model.Rows.Count == 0)
{
    <p>Inga pass den här veckan.</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Träningstyp</th><th>Träningstid</th><th>Veckomål</th></tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td>@row.TrainingType</td>
                    <td>@row.Time</td>
                    <td>@(row.Goal ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>
}
