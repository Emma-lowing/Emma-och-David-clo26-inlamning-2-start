@model ExerciseFormModel
@{
    ViewData["Title"] = "Lägg till övning";
    var workout = (Workout)ViewData["Workout"]!;
}

<h1>Lägg till övning</h1>
<p class="text-muted">Till passet @workout.Type, @workout.Date.ToString("dddd d MMMM yyyy")</p>

<form asp-action="AddExercise" asp-route-id="@workout.Id" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" placeholder="Knäböj" />
    </div>
    <div class="row g-3 mb-3">
        @* type="text" så att felaktig inmatning ger ett meddelande från servern. *@
        <div class="col">
            <label asp-for="Sets" class="form-label">Set</label>
            <input asp-for="Sets" type="text" class="form-control" placeholder="3" />
        </div>
        <div class="col">
            <label asp-for="Reps" class="form-label">Reps</label>
            <input asp-for="Reps" type="text" class="form-control" placeholder="8" />
        </div>
        <div class="col">
            <label asp-for="Weight" class="form-label">Vikt i kg</label>
            <input asp-for="Weight" type="text" class="form-control" placeholder="62,5" />
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Spara</button>
    <a class="btn btn-link" asp-action="Details" asp-route-id="@workout.Id">Avbryt</a>
</form>
