@model List<Workout>
@{
    ViewData["Title"] = "Pass";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Pass</h1>
    <a class="btn btn-primary" asp-action="Create">Lägg till pass</a>
</div>

@if (Model.Count == 0)
{
    <p>Det finns inga pass än.</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Datum</th><th>Träningstyp</th><th>Övningar</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (Workout workout in Model)
            {
                <tr>
                    <td>@workout.Date.ToString("ddd d MMM yyyy")</td>
                    <td>@workout.Type</td>
                    <td>@workout.Exercises.Count</td>
                    @* Du behöver bygga ut detta mer: visa längd och utövare när modellen Workout har dem. *@
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@workout.Id">Visa</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@workout.Id">Ta bort</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
