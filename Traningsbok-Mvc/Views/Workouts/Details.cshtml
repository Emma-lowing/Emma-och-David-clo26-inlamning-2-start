@model WorkoutDetailsViewModel
@{
    ViewData["Title"] = Model.Type;
}

<h1>@Model.Type</h1>
<p class="text-muted">@Model.Date.ToString("dddd d MMMM yyyy")</p>

@* Du behöver bygga ut detta mer: visa längd, anteckning och utövare. *@

<h2 class="h5">Övningar</h2>
@if (Model.ExerciseLines.Count == 0)
{
    <p>Passet har inga övningar än.</p>
}
else
{
    <ul>
        @foreach (string line in Model.ExerciseLines)
        {
            <li>@line</li>
        }
    </ul>
}

<a class="btn btn-primary" asp-action="AddExercise" asp-route-id="@Model.Id">Lägg till övning</a>
<a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Ta bort passet</a>
<a class="btn btn-link" asp-action="Index">Tillbaka till passen</a>
