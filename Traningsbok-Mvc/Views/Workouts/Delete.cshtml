@model Workout
@{
    ViewData["Title"] = "Ta bort pass";
}

<h1>Ta bort pass</h1>

<div class="alert alert-warning">
    Är du säker på att du vill ta bort passet <strong>@Model.Type</strong> den <strong>@Model.Date.ToString("d MMMM yyyy")</strong>?
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Ja, ta bort</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Nej, avbryt</a>
</form>
