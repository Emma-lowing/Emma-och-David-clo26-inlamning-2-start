@using Microsoft.AspNetCore.Mvc.Rendering
@model WorkoutFormModel
@{
    ViewData["Title"] = "Lägg till pass";
    var trainingTypes = (List<SelectListItem>)ViewData["TrainingTypes"]!;
}

<h1>Lägg till pass</h1>

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Date" class="form-label"></label>
        <input asp-for="Date" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Type" class="form-label"></label>
        <select asp-for="Type" asp-items="trainingTypes" class="form-select">
            <option value="">Välj träningstyp</option>
        </select>
    </div>

    @* Du behöver bygga ut detta mer: fält för längd i minuter, anteckning och utövare när modellen Workout har dem. *@

    <button type="submit" class="btn btn-primary">Spara</button>
    <a class="btn btn-link" asp-action="Index">Avbryt</a>
</form>
