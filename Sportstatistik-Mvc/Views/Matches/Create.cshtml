@using Microsoft.AspNetCore.Mvc.Rendering
@model MatchFormModel
@{
    ViewData["Title"] = "Registrera match";
    var teams = (List<SelectListItem>)ViewData["Teams"]!;
}

<h1>Registrera match</h1>

<form asp-action="Create" method="post" class="col-md-8">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="HomeTeamId" class="form-label"></label>
            <select asp-for="HomeTeamId" asp-items="teams" class="form-select"></select>
        </div>
        <div class="col-md-6">
            <label asp-for="AwayTeamId" class="form-label"></label>
            <select asp-for="AwayTeamId" asp-items="teams" class="form-select"></select>
        </div>
    </div>
    <div class="row g-3 mb-3">
        @* type="text" så att felaktig inmatning, till exempel "abc", ger ett meddelande från servern. *@
        <div class="col-md-3">
            <label asp-for="HomeGoals" class="form-label"></label>
            <input asp-for="HomeGoals" type="text" inputmode="numeric" class="form-control" placeholder="2" />
        </div>
        <div class="col-md-3">
            <label asp-for="AwayGoals" class="form-label"></label>
            <input asp-for="AwayGoals" type="text" inputmode="numeric" class="form-control" placeholder="1" />
        </div>
    </div>

    @* Du behöver bygga ut detta mer: fält för datum och anteckning när modellen Match har dem. *@

    <button type="submit" class="btn btn-primary">Spara</button>
    <a class="btn btn-link" asp-action="Index">Avbryt</a>
</form>
