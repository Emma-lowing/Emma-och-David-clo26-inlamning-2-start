@model List<MatchRowViewModel>
@{
    ViewData["Title"] = "Matcher";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Matcher</h1>
    <a class="btn btn-primary" asp-action="Create">Registrera match</a>
</div>

@if (Model.Count == 0)
{
    <p>Det finns inga matcher än.</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Hemmalag</th><th>Bortalag</th><th>Resultat</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (MatchRowViewModel match in Model)
            {
                <tr>
                    @* Du behöver bygga ut detta mer: visa datum och anteckning när modellen Match har dem. *@
                    <td>@match.HomeTeam</td>
                    <td>@match.AwayTeam</td>
                    <td>@match.Result</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@match.Id">Ta bort</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
