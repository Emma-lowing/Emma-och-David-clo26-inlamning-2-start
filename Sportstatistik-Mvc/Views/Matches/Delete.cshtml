@model MatchRowViewModel
@{
    ViewData["Title"] = "Ta bort match";
}

<h1>Ta bort match</h1>

<div class="alert alert-warning">
    Är du säker på att du vill ta bort <strong>@Model.Title, @Model.Result</strong>?
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Ja, ta bort</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Nej, avbryt</a>
</form>
