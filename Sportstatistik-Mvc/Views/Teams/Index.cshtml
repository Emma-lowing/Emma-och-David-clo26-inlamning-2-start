@model List<TeamSummaryViewModel>
@{
    ViewData["Title"] = "Lag";
}

<h1>Lag</h1>

@if (Model.Count == 0)
{
    <p>Det finns inga lag än.</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Namn</th><th>Spelare</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (TeamSummaryViewModel team in Model)
            {
                <tr>
                    <td>@team.Name</td>
                    <td>@team.PlayerCount</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@team.Id">Visa spelare</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="AddPlayer" asp-route-teamId="@team.Id">Lägg till spelare</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h2 class="h5 mt-4">Lägg till lag</h2>
<form asp-action="Create" method="post" class="row g-2">
    <div class="col-auto">
        <input name="name" class="form-control" placeholder="Till exempel Ummis IF" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Lägg till</button>
    </div>
</form>
