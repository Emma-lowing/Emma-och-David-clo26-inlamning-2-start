@model TeamDetailsViewModel
@{
    ViewData["Title"] = Model.Team.Name;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Model.Team.Name</h1>
    <a class="btn btn-primary" asp-action="AddPlayer" asp-route-teamId="@Model.Team.Id">Lägg till spelare</a>
</div>

<p class="text-muted">@Model.Players.Count spelare</p>

@if (Model.Players.Count == 0)
{
    <p>Laget har inga spelare än.</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Namn</th><th>Position</th></tr>
        </thead>
        <tbody>
            @foreach (Player player in Model.Players)
            {
                <tr>
                    <td>@player.FirstName @player.LastName</td>
                    <td>@player.Position</td>
                </tr>
            }
        </tbody>
    </table>
}

<a class="btn btn-link" asp-action="Index">Tillbaka till lagen</a>
