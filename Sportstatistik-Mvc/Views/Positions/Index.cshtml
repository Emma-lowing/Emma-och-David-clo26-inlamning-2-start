@model List<Position>
@{
    ViewData["Title"] = "Positioner";
}

<h1>Positioner</h1>

<table class="table">
    <thead>
        <tr><th>Namn</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (Position position in Model)
        {
            <tr>
                <td>@position.Name</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@position.Id">Ta bort</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<h2 class="h5 mt-4">Lägg till position</h2>
<form asp-action="Create" method="post" class="row g-2">
    <div class="col-auto">
        <input name="name" class="form-control" placeholder="Till exempel Libero" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Lägg till</button>
    </div>
</form>
