@model int
@* Val av säsong. En säsong följer kalenderåret. Används av både tabellen och truppgränserna. *@
<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label for="season" class="form-label">Säsong</label>
        <input id="season" name="season" type="number" min="2000" max="2100" value="@Model" class="form-control" style="width:8rem" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Visa</button>
    </div>
</form>
