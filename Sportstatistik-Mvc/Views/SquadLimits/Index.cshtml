@model SquadLimitsViewModel
@{
    ViewData["Title"] = "Truppgränser";
}

<h1>Truppgränser, säsong @Model.Season</h1>

<partial name="_SeasonPicker" model="Model.Season" />

<table class="table">
    <thead>
        <tr><th>Lag</th><th>Spelare</th><th>Truppgräns</th><th>Ny gräns</th></tr>
    </thead>
    <tbody>
        @foreach (SquadLimitRowViewModel row in Model.Rows)
        {
            <tr>
                <td>@row.TeamName</td>
                <td>@row.PlayerCount</td>
                <td>@(row.MaxPlayers is null ? "Ingen gräns" : $"Högst {row.MaxPlayers}")</td>
                <td>
                    <form asp-action="SetLimit" method="post" class="d-flex gap-2">
                        <input type="hidden" name="teamId" value="@row.TeamId" />
                        <input type="hidden" name="season" value="@Model.Season" />
                        <input name="maxPlayers" inputmode="numeric" class="form-control form-control-sm" style="width:6rem" />
                        <button type="submit" class="btn btn-sm btn-outline-primary">Spara</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<p class="text-muted small">
    När ett lag når 80 % av truppgränsen får användaren en varning, och vid 100 % en annan.
</p>
